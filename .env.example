# ========================================================
# Oracle Container Registry 인증 정보 (docker login 시 사용)
# ========================================================
ORACLE_REGISTRY_USER=your_oracle_email@domain.com
ORACLE_REGISTRY_TOKEN=your_oracle_container_registry_auth_token

# ========================================================
# Oracle Database 기본 설정
# ========================================================
ORACLE_PWD=YourSecurePassword123!
ORACLE_CHARACTERSET=AL32UTF8
ORACLE_PORT=1521
EM_EXPRESS_PORT=39832

# ========================================================
# 스키마 계정 비밀번호 설정
# ========================================================
HR_USER_PWD=hr1234
INFORM_NOTE_PWD=YourSecurePassword123!
